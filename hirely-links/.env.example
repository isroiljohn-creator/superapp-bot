# All settings are read from HIRELY_* environment variables. Nothing secret is stored in the code.

# Postgres (a dedicated "hirely" schema is created and managed by Alembic)
HIRELY_DATABASE_URL=postgresql+asyncpg://user:password@db:5432/dbname
# Optional but recommended with >1 worker: shared rate limits
HIRELY_REDIS_URL=redis://default:password@redis:6379/1

# Public base URL used to build tracking links returned to the bot
HIRELY_PUBLIC_BASE_URL=https://yashaai.uz

# >= 32 random chars. Signs admin sessions and ad tokens. Rotating it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HIRELY_SECRET_KEY=

# Comma-separated bot API tokens (each >= 24 chars). Two values = zero-downtime rotation.
HIRELY_BOT_API_TOKENS=

# First admin, created only when the admins table is empty (password >= 10 chars)
HIRELY_BOOTSTRAP_ADMIN_EMAIL=
HIRELY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional
HIRELY_MEDIA_DIR=/data/media
HIRELY_DISPLAY_TZ=Asia/Tashkent
HIRELY_COOKIE_SECURE=true
# Header carrying the real client IP (nginx must SET it). Behind Cloudflare: cf-connecting-ip
HIRELY_CLIENT_IP_HEADER=x-real-ip
HIRELY_ADMIN_SESSION_HOURS=12
HIRELY_MAX_UPLOAD_MB=6
